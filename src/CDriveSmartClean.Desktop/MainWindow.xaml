<Window x:Class="CDriveSmartClean.Desktop.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:CDriveSmartClean.Desktop.Resources"
        Title="CDriveSmartClean" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Padding="12" Margin="0,0,0,12" BorderBrush="#FFB8C7D9"
                BorderThickness="1" CornerRadius="4" Background="#FFF3F7FB">
            <TextBlock x:Name="SafetyBannerText" Text="{x:Static resources:Strings.AnalysisOnlyBanner}"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>
        <Grid x:Name="TopControls" DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="StartScanButton" Grid.Column="0" Content="{x:Static resources:Strings.StartScan}" Command="{Binding StartCommand}"
                    MinWidth="110" Padding="12,6" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="{x:Static resources:Strings.Cancel}" Command="{Binding CancelCommand}"
                    MinWidth="90" Padding="12,6" Margin="8,0,0,0" />
            <TextBlock Grid.Column="2" Text="{x:Static resources:Strings.State}" Margin="20,0,4,0"
                       VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{x:Static resources:Strings.Language}" Margin="20,0,4,0"
                       VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox x:Name="LanguageSelector" Grid.Column="5" Width="100" ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName"
                      SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay,
                      UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                      AutomationProperties.Name="{x:Static resources:Strings.Language}" />
            <StackPanel Grid.Column="6" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF9B1C1C" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LanguageMessage}" Foreground="#FF305D2A" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <GroupBox DockPanel.Dock="Top" Header="{x:Static resources:Strings.ScanProgress}" Margin="0,0,0,12">
            <UniformGrid Rows="2" Columns="4" Margin="10">
                <TextBlock Text="{x:Static resources:Strings.Phase}" FontWeight="SemiBold" /><TextBlock Text="{Binding ProgressPhaseText}" />
                <TextBlock Text="{x:Static resources:Strings.ObjectsObserved}" FontWeight="SemiBold" /><TextBlock Text="{Binding ObjectsObserved}" />
                <TextBlock Text="{x:Static resources:Strings.RawReportedAllocatedBytes}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RawReportedAllocatedBytesObserved}" />
                <TextBlock Text="{x:Static resources:Strings.TraversalIssuesObserved}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TraversalIssuesObserved}" />
            </UniformGrid>
        </GroupBox>
        <TabControl x:Name="MainTabs">
            <TabItem Header="{x:Static resources:Strings.Overview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <GroupBox Header="{x:Static resources:Strings.SystemVolume}" Margin="0,0,0,12"><UniformGrid Rows="2" Columns="4" Margin="10">
                        <TextBlock Text="{x:Static resources:Strings.Root}" FontWeight="SemiBold" /><TextBlock Text="{Binding VolumeSummary.RootPath}" />
                        <TextBlock Text="{x:Static resources:Strings.Capacity}" FontWeight="SemiBold" /><TextBlock Text="{Binding VolumeSummary.Capacity}" />
                        <TextBlock Text="{x:Static resources:Strings.Used}" FontWeight="SemiBold" /><TextBlock Text="{Binding VolumeSummary.Used}" />
                        <TextBlock Text="{x:Static resources:Strings.Free}" FontWeight="SemiBold" /><TextBlock Text="{Binding VolumeSummary.Free}" />
                    </UniformGrid></GroupBox>
                    <GroupBox Header="{x:Static resources:Strings.QualityAndCoverage}" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding QualityRows}" Margin="10"><ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" />
                                <TextBlock Grid.Column="2" Text="{Binding Reason}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </GroupBox>
                    <GroupBox Header="{x:Static resources:Strings.CategoryAllocation}" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding CategoryRows}" Margin="10"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="{Binding Category}" Width="180" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Allocated}" /></StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </GroupBox>
                    <GroupBox Header="{x:Static resources:Strings.TraversalIssues}">
                        <ItemsControl ItemsSource="{Binding IssueRows}" Margin="10"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2"><TextBlock Text="{Binding Kind}" Width="240" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Count}" /></StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static resources:Strings.Findings}">
                <DataGrid x:Name="FindingsGrid" ItemsSource="{Binding FindingRows}" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                          EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static resources:Strings.Name}" Binding="{Binding DisplayName}" Width="2*" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Category}" Binding="{Binding Category}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Scope}" Binding="{Binding Scope}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Allocated}" Binding="{Binding Allocated}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Logical}" Binding="{Binding Logical}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Reclaim}" Binding="{Binding Reclaim}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Risk}" Binding="{Binding Risk}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.RiskConfidence}" Binding="{Binding RiskConfidence}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.FindingConfidence}" Binding="{Binding Confidence}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Protection}" Binding="{Binding ProtectionState}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Facets}" Binding="{Binding Facets}" Width="2*" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Path}" Binding="{Binding RelativePathSummary}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
